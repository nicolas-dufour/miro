# MIRO environment template — copy to ``.env`` and fill in.
#
#   cp .env.example .env
#   set -a; source .env; set +a    # or: direnv allow .
#
# Every variable has a sensible fallback baked into the code, so you only
# need to set the ones that don't match your cluster / wandb account.

# === Data ====================================================================
# Root containing the enriched webdataset tars (the output of
# ``miro/data/preprocess_data.py``). Expected layout:
#   $MIRO_DATA_DIR/cc12m/train/*.tar
#   $MIRO_DATA_DIR/cc12m/val/*.tar
#   $MIRO_DATA_DIR/laion_aesthetics_6.0/*.tar
MIRO_DATA_DIR=/path/to/enriched_tars

# === SLURM (training launchers) =============================================
# Partition to submit to. Required by ``miro/slurm/launch.py`` — there is no
# default.
MIRO_SLURM_PARTITION=

# Where SLURM writes job .out / .err logs. Defaults to ``./slurm-logs`` under
# the project root when unset.
MIRO_SLURM_OUTPUT_DIR=./slurm-logs

# Extra colon-separated paths prepended to PYTHONPATH inside each SLURM job
MIRO_PYTHONPATH=

# === Weights & Biases ========================================================
# Override the wandb project / entity used by the training run. If unset,
# ``project=miro`` and the wandb default entity (your personal namespace) are
# used.
WANDB_PROJECT=miro
WANDB_ENTITY=

# === HuggingFace =============================================================
# Token used by ``scripts/convert_and_upload_to_hf.py --push`` and by
# ``MiroPipeline.from_pretrained`` for private repos. Prefer ``huggingface-cli
# login`` over inlining the token here.
# HF_TOKEN=hf_...
